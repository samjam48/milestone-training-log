# ── Backend ──────────────────────────────────────────────────────────────────
# Local dev uses sqlite (last DATABASE_URL wins if you copy this file to .env).
# Production DATABASE_URL is Supabase only — comment out sqlite and use the shape below.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@db.PROJECT.supabase.co:5432/postgres
DATABASE_URL=sqlite:///./data/milestone.db
# URL-encode passwords with special characters in DATABASE_URL (e.g. @ → %40).
# If Render cannot reach the direct host, try Supabase Session pooler (port 6543).

APP_VERSION=0.1.0
BACKEND_PORT=8084
DEFAULT_USER_NAME=Sam
# Enable dev-only endpoints (POST /api/dev/reset). Never true in production.
APP_DEV_MODE=false

# Session signing key. Dev default below is insecure — do not use in production.
# Generate for production: openssl rand -hex 32
SESSION_SECRET=dev-insecure-do-not-use-in-production

# Shared app login password. Required on Render (APP_DEV_MODE=false).
# Leave empty for local dev without login — API routes stay open until you set this.
# Optional: set AUTH_PASSWORD here to exercise POST /api/auth/login locally.
AUTH_PASSWORD=

# Session cookie lifetime in days.
SESSION_MAX_AGE_DAYS=30

CORS_ORIGINS=
# Optional — comma-separated browser origins for direct API access (see B11.6).
# Leave empty when the frontend uses the Netlify /api proxy only.

# ── Frontend ─────────────────────────────────────────────────────────────────
FRONTEND_PORT=5151
# Show the "Reset mock data" button in Settings. Never true in production.
VITE_DEV_MODE=false
